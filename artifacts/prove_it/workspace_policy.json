{
  "policyId": "workspace_writer",
  "defaultAllow": false,
  "allowedCapabilities": [
    {"action": "file:write", "pattern": {"type": "prefix", "prefix": "/workspace/"}},
    {"action": "file:read", "pattern": {"type": "prefix", "prefix": "/workspace/"}},
